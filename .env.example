# Copy to .env (gitignored) and fill in.

# Resume tailor repo (has tailor.py --json), e.g. a clone of your resume-tailor project.
TAILOR_DIR=
# Python that runs the tailor (defaults to the one running the dashboard).
TAILOR_PYTHON=

# Optional overrides (found on PATH by default).
NODE_BIN=
CLAUDE_BIN=

DASHBOARD_PORT=8765
# Browser program that opens the dashboard (full path to its .exe). Empty = system default.
DASHBOARD_BROWSER=
# Chromium-based browsers: profile folder (--user-data-dir) so the link opens in the running window.
DASHBOARD_BROWSER_PROFILE=
# Start a scan every day at this local time while the dashboard runs, e.g. 09:00. Empty = off.
DAILY_SCAN_AT=

# After each scan, prepare applications (resume + every form answer) for jobs with these
# experience badges: fits, stretch, senior, unknown. Empty = off.
AUTO_PREPARE=fits,stretch
# Also grade prepared jobs with headless Claude Code (needs `claude` signed in). 0 = off.
AUTO_EVALUATE=1

# AI for drafting form answers (OpenAI-compatible). If empty, the tailor's .env is used.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
